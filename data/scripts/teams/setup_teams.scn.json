{
  "declare_macro": "setup_teams",
  "content": {
    "required": "(%remote_role != 'client')",
    "execute": [
      {
        "call": "set_way_points",
        "arguments": {
          "location": "%osm_location",
          "resource": "%teams_way_points_resource"
        }
      },
      {
        "call": "set_spawn_points",
        "arguments": {
          "location": "%osm_location",
          "resource": "%teams_spawn_points_resource"
        }
      },
      {
        "call": "compute_random_user_ranks"
      },
      {
        "call": "load_players",
        "arguments": {
          "json": "%players_json"
        }
      },
      {
        "call": "set_objective",
        "arguments": {
          "objective": "%objective"
        }
      }
    ],
    "else_":{
      "call": "load_players",
      "arguments": {
        "json": "%players_json"
      }
    }
  }
}
