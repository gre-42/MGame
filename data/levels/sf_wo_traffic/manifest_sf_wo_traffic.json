{
  "id": "sf_wo_traffic",
  "title": "WIP: San Francisco without traffic",
  "required": {
    "fixed": ["%if_devel", "(%user_count <= %max_users)"],
    "dynamic": "(%selected_game_mode in %game_modes)"
  },
  "on_init": {
    "declare_macro": "remote.level.load_sf_wo_traffic",
    "content": {
      "call": "load_scene",
      "arguments": {
        "filename": "file://$__DIR__/manifest_sf_wo_traffic.json"
      }
    }
  },
  "on_execute": [
    {
      "call": "globals",
      "arguments": {
        "loaded_level_id": "sf_wo_traffic",
        "minimap_file": null
      }
    },
    {
      "include": "scene_sf_wo_traffic.scn"
    }
  ],
  "on_before_select": {
    "call": "globals",
    "arguments": {
      "selected_level_id": "sf_wo_traffic",
      "level_icon_file": "#black"
    }
  },
  "database": {
    "if_raceway_circular": false,
    "game_modes": ["rally"],
    "max_users": 1
  }
}
