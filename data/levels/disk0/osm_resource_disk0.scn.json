{
  "declare_macro": "osm_resource_disk0",
  "content": {
    "call": "osm_resource",
    "arguments": {
      "sparse_triangle_cluster_width": "%sparse_triangle_cluster_width",
      "medium_triangle_cluster_width": "%medium_triangle_cluster_width",
      "dense_triangle_cluster_width": "%dense_triangle_cluster_width",
      "object_cluster_width": "%object_cluster_width",
      "name": "osm_map",
      "filenames": ["file://$__DIR__/map_disk0.osm"],
      "cache_filename": "file://$__APPDATA__/$loaded_level_id.cereal.binary",
      "terrain_undefined_textures": ["#pink"],
      "terrain_grass_textures": [
        "#Gravel010_Base",
        "#Ground037_1",
        "#Ground037_8"],
      "bounding_terrain_type": "grass",
      "default_terrain_type": "grass",
      "terrain_materials": {
        "grass": "surface_base_grass",
        "wayside1_grass": "surface_base_grass",
        "wayside2_grass": "surface_base_grass",
        "flowers": "surface_base_grass",
        "trees": "surface_base_grass",
        "elevated_grass": "surface_base_grass",
        "elevated_grass_base": "surface_base_stone",
        "stone": "surface_base_stone",
        "asphalt": "surface_base_tarmac",
        "water_floor": "none",
        "water_floor_base": "none",
        "street_hole": "none",
        "building_hole": "none",
        "ocean_ground": "none",
        "undefined": "none"},
      "path_materials": "surface_base_gravel",
      "wall_materials": "surface_base_stone",
      "grass_dirt_texture": "#Ground025",
      "path_alpha_textures": [
        "#PlusDetail",
        "#TimesBlend5",
        "#Ramp5"
      ],
      "path_crossing_textures": ["#Road007_No_Lines_Detail_Base", "#Gravel010_Detail"],
      "path_textures": [{
        "lanes": 1, "textures": ["#Road007_2_Lanes_Detail_Base", "#Gravel010_Detail"]}],
      "wall_textures": [
        {"lanes": 1, "textures": ["#PavingStones046"], "uvx": 0.15}],
      "ceiling_texture": "#Asphalt015",
      "barrier_styles": [
        {
          "name": "fence1",
          "texture": "#fence1",
          "uv": [1, 1],
          "depth": 0,
          "blend_mode": "semi_continuous_02",
          "cull_faces": false,
          "reorient_uv0": false,
          "ambient": [0.7, 0.7, 0.7],
          "diffuse": [0.5, 0.5, 0.5],
          "specular": [0, 0, 0],
          "fresnel": {
            "min": 0,
            "max": 0.5,
            "exponent": 4,
            "ambient": [1, 1, 1]
          }
        }],
      "roof_texture": "#RoofingTiles002Red",
      "default_street_width": 5,
      "scale": 1,
      "uv_scale_terrain": 3e-1,
      "uv_period_terrain": 512,
      "uv_scale_path": 1e-1,
      "uv_scale_wall": 1e-1,
      "uv_scale_facade": 2.5e-1,
      "uv_scale_ceiling": 1e-1,
      "uv_scale_barrier_wall": 5,
      "uv_scale_crossings": 1e-1,
      "with_roofs": false,
      "with_ceilings": true,
      "building_bottom": 0,
      "default_building_top": 10,
      "default_barrier_top": 2,
      "remove_backfacing_triangles": true,
      "with_tree_nodes": true,
      "forest_outline_tree_distance": 10,
      "forest_outline_tree_inwards_distance": 1,
      "much_grass_distance": 20,
      "much_near_grass_distance": 3,
      "much_near_flowers_distance": 2,
      "raceway_beacon_distance": "inf",
      "with_terrain": true,
      "with_buildings": true,
      "only_raceways_and_walls": false,
      "highway_name_pattern": "",
      "path_tags": ["track"],
      "smoothed_highways": ["track"],
      "max_smooth_highway_length": 2,
      "steiner_point_distances_road": [],
      "steiner_point_distances_steiner": [],
      "curb_alpha": 1,
      "curb2_alpha": 1,
      "curb_uv_x": "nan",
      "curb2_uv_x": "nan",
      "raise_streets_amount": 0,
      "extrude_curb_amount": 0,
      "extrude_street_amount": 0,
      "extrude_wall_amount": 0.3,
      "stop_sign_resource_names": [],
      "max_wall_width": 10,
      "with_height_bindings": true,
      "street_node_smoothness": 0,
      "street_edge_smoothness": 0,
      "terrain_edge_smoothness": 0.1,
      "with_street_way_points": false,
      "with_sidewalk_way_points": false,
      "driving_direction": "right",
      "blend_street": true,
      "blend_path": true,
      "emissive_factor": "%default_emissive_factor",
      "ambient_factor": "%default_ambient_factor",
      "diffuse_factor": "%default_diffuse_factor",
      "specular_factor": "%default_specular_factor",
      "fog_distances": "%fog_distances",
      "fog_ambient": "%fog_ambient"
    }
  }
}
