{
  "id": "islands1",
  "title": "%/title/$selected_language",
  "required": {
    "fixed": ["(%flavor == 'extended')", "(%user_count <= %max_users)"],
    "dynamic": "(%selected_game_mode in %game_modes)"
  },
  "on_init": {
    "declare_macro": "remote.level.load_islands1",
    "content": {
      "call": "load_scene",
      "arguments": {
        "filename": "file://$__DIR__/manifest_islands1.json"
      }
    }
  },
  "on_execute": [
    {
      "call": "globals",
      "arguments": {
        "loaded_level_id": "islands1",
        "loaded_game_level": "td0",
        "minimap_file": null,
        "players_json_basename": "players.json"
      }
    },
    {
      "include": "scene_islands1.scn.json"
    }
  ],
  "on_before_select": {
    "call": "globals",
    "arguments": {
      "selected_level_id": "islands1",
      "level_icon_file": "#black"
    }
  },
  "database": {
    "if_raceway_circular": false,
    "game_modes": ["team_deathmatch"],
    "max_users": 1,
    "title": {
      "de-DE": "Inseln 1",
      "en-US": "Islands 1",
      "fr-FR": "Îles 1"
    }
  }
}
