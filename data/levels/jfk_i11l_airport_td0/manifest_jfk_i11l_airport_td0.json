{
  "id": "jfk_i11l_airport_td0",
  "title": "%/title/$selected_language",
  "required": {
    "fixed": ["(%flavor == 'extended')", "(%user_count <= %max_users)", "%if_devel"],
    "dynamic": "(%selected_game_mode in %game_modes)"
  },
  "on_init": {
    "declare_macro": "remote.level.load_jfk_i11l_airport_td0",
    "content": {
      "call": "load_scene",
      "arguments": {
        "filename": "file://$__DIR__/manifest_jfk_i11l_airport_td0.json"
      }
    }
  },
  "on_execute": [
    {
      "call": "globals",
      "arguments": {
        "loaded_level_id": "jfk_i11l_airport_td0",
        "loaded_game_level": "td0",
        "minimap_file": null
      }
    },
    {
      "include": "scene_jfk_i11l_airport_td0.scn.json"
    }
  ],
  "on_before_select": {
    "call": "globals",
    "arguments": {
      "selected_level_id": "jfk_i11l_airport_td0",
      "level_icon_file": "#black"
    }
  },
  "database": {
    "if_raceway_circular": false,
    "game_modes": ["team_deathmatch"],
    "max_users": 2,
    "title": {
      "de-DE": "JFK I11l Airport, Team Deathmatch 0",
      "en-US": "JFK I11l Airport, team deathmatch 0",
      "fr-FR": "JFK I11l Airport, team deathmatch 0"
    }
  }
}
