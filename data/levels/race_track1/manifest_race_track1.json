{
  "id": "race_track1",
  "title": "%/title/$selected_language",
  "required": {
    "fixed": "(%user_count <= %max_users)",
    "dynamic": "(%selected_game_mode in %game_modes)"
  },
  "on_init": {
    "declare_macro": "remote.level.load_race_track1",
    "content": {
      "call": "load_scene",
      "arguments": {
        "filename": "file://$__DIR__/manifest_race_track1.json"
      }
    }
  },
  "on_execute": [
    {
      "call": "globals",
      "arguments": {
        "loaded_level_id": "race_track1",
        "minimap_file": null
      }
    },
    {
      "include": "scene_race_track1.scn.json"
    }
  ],
  "on_before_select": {
    "call": "globals",
    "arguments": {
      "selected_level_id": "race_track1",
      "level_icon_file": "file://levels/race_track1/icon.png"
    }
  },
  "database": {
    "max_users": 2,
    "0": {
      "car_node_position": [3, -170, -242],
      "car_node_angles": [180, -13, -180]
    },
    "1": {
      "car_node_position": [-3, -170, -242],
      "car_node_angles": [180, -13, -180]
    },
    "if_raceway_circular": true,
    "game_modes": ["rally"],
    "title": {
      "de-DE": "Rennstrecke 1",
      "en-US": "Race track 1",
      "fr-FR": "Piste de course 1"
    }
  }
}
