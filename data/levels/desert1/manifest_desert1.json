{
  "id": "desert1",
  "title": "%/title/$selected_language",
  "required": {
    "fixed": "(%user_count <= %max_users)",
    "dynamic": "(%selected_game_mode in %game_modes)"
  },
  "on_init": {
    "declare_macro": "remote.level.load_desert1",
    "content": {
      "call": "load_scene",
      "arguments": {
        "filename": "file://$__DIR__/manifest_desert1.json"
      }
    }
  },
  "on_execute": [
    {
      "call": "globals",
      "arguments": {
        "loaded_level_id": "desert1",
        "minimap_file": null
      }
    },
    {
      "include": "scene_desert1.scn.json"
    }
  ],
  "on_before_select": {
    "call": "globals",
    "arguments": {
      "selected_level_id": "desert1",
      "level_icon_file": "file://levels/desert1/icon.png"
    }
  },
  "database": {
    "max_users": 1,
    "0": {
      "car_node_position": [
        "-113.3258598_deg",
        "35.7393636_deg",
        "142"],
      "car_node_angles": [0, 140, 0]
    },
    "if_raceway_circular": false,
    "game_modes": ["rally"],
    "title": {
      "de-DE": "Wüste 1",
      "en-US": "Desert 1",
      "fr-FR": "Désert 1"
    }
  }
}
